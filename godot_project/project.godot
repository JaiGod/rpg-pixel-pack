; Engine configuration file.
; Open this folder with Godot 4.3 or newer.

config_version=5

[application]

config/name="RPG Pixel Pack Demo"
config/description="Demo project for the RPG Pixel Pack: layered characters, monsters, tilesets, interiors, inventory & equipment."
run/main_scene="res://demo/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RPGInput="*res://rpg_pixel_pack/scripts/input_setup.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
